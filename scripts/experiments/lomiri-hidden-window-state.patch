+    void testHiddenStateDoesNotPreventReopening() {
+        QTemporaryDir directory;
+        QVERIFY(directory.isValid());
+        const QString databasePath = directory.filePath("states.sqlite");
+        const QString id = QStringLiteral("test-terminal");
+        delete storage;
+        storage = new WindowStateStorage(databasePath, this);
+
+        storage->saveState(id, Mir::MaximizedState);
+        QCOMPARE(storage->getState(id, Mir::RestoredState), Mir::MaximizedState);
+        storage->saveState(id, Mir::HiddenState);
+        QCOMPARE(storage->getState(id, Mir::RestoredState), Mir::MaximizedState);
+
+        // Simulate a hidden state saved by a previous shell version.
+        const QString connectionName = QStringLiteral("legacy-hidden-state-test");
+        {
+            auto database = QSqlDatabase::addDatabase("QSQLITE", connectionName);
+            database.setDatabaseName(databasePath);
+            QVERIFY(database.open());
+            QSqlQuery query(database);
+            query.prepare("UPDATE state SET state=? WHERE windowId=?");
+            query.addBindValue(static_cast<int>(Mir::HiddenState));
+            query.addBindValue(id);
+            QVERIFY(query.exec());
+            QCOMPARE(query.numRowsAffected(), 1);
+        }
+        QSqlDatabase::removeDatabase(connectionName);
+        QCOMPARE(storage->getState(id, Mir::RestoredState), Mir::RestoredState);
+    }
