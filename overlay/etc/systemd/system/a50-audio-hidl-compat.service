[Unit]
Description=A50: present the 64-bit audio HIDL compat wrapper to PulseAudio
Documentation=https://github.com/sadatdaniel/a50-ubuntu-touch/blob/main/docs/experiments/007-abox-firmware-too-early.md
# linkerconfig writes /linkerconfig/ld.config.txt as the Android container
# starts, and the script waits for it. This must land before the user session
# starts PulseAudio, or PulseAudio loads the 12 KB generic stub instead of the
# wrapper and silently discards every write.
After=lxc-android-config.service
Wants=lxc-android-config.service
Before=lightdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/a50-audio-hidl-compat.sh
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
