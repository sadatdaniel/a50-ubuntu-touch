# A50 non-A/B physical partitions. Never format from this build script.
# /cache is deliberately omitted: unified recovery provides its userdata-backed cache.
/dev/block/platform/13520000.ufs/by-name/userdata /data ext4 noatime,nosuid,nodev,noauto_da_alloc,discard wait,check
/dev/block/platform/13520000.ufs/by-name/system /system ext4 ro wait
/dev/block/platform/13520000.ufs/by-name/boot /boot emmc defaults defaults
/dev/block/platform/13520000.ufs/by-name/recovery /recovery emmc defaults defaults
/dev/block/platform/13520000.ufs/by-name/misc /misc emmc defaults defaults
